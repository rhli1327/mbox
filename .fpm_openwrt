-s dir
--name mbox
--category net
--license GPL-3.0-or-later
--description "The universal proxy platform."
--url "https://github.com/rhli1327/mbox"
--maintainer "nekohasekai <contact-git@sekai.icu>"
--no-deb-generate-changes

--config-files /etc/config/mbox
--config-files /etc/mbox/config.json

--depends ca-bundle
--depends kmod-inet-diag
--depends kmod-tun
--depends firewall4
--depends kmod-nft-queue

--before-remove release/config/openwrt.prerm

release/config/config.json=/etc/mbox/config.json

release/config/openwrt.conf=/etc/config/mbox
release/config/openwrt.init=/etc/init.d/mbox
release/config/openwrt.keep=/lib/upgrade/keep.d/mbox

release/completions/mbox.bash=/usr/share/bash-completion/completions/mbox.bash
release/completions/mbox.fish=/usr/share/fish/vendor_completions.d/mbox.fish
release/completions/mbox.zsh=/usr/share/zsh/site-functions/_mbox

LICENSE=/usr/share/licenses/mbox/LICENSE
